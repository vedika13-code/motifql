[{"id": "synth", "name": "Compiler chooses the error budgets", "program": "// The compiler chooses the error budgets from a stated limit:\n// at most 2 chance hits per 100,000 letters, scored on sites\n// that have drifted 10% from the consensus.\nalphabet DNA;\nmotif tata  = \"TATAWAWR\" allow ? edits;\nmotif kozak = \"RCCATGG\"  allow ? edits;\nmotif promoter { @tata \"N\"{20,40} @kozak }\n    require rate <= 2 per 100kb, divergence 10%;\nsearch promoter in \"perpart.fa\";\n", "files": {"perpart.fa": ">perpart\nCCCCCCCCCCTATAAAAGGGGGCCCCCGGGGGCCCCCGGGGGCCGCCATGGCCCCCCCCCCCCCCCCCCTATAAAGGGGGCCCCCGGGGGCCCCCGGGGGCCGCCATGGCCCCCCCCCCCCCCCCCCTATAAAAGGGGGCCCCCGGGGGCCCCCGGGGGCCGCATGGCCCCCCCCCC\n"}, "settings": {}}, {"id": "ecori", "name": "EcoRI site: exact vs one mismatch", "program": "// Demo: one small motif, shown through every compiler phase.\nalphabet DNA;\n\nmotif site = \"GAATTC\";                    // EcoRI site, exact\nmotif site_mm = \"GAATTC\" allow 1 mismatch;\n\nsearch site    in \"demo.fa\";\nsearch site_mm in \"demo.fa\";\n", "files": {"demo.fa": ">demo\nAAAAGAATTCAAAAAAGATTTCAAAAAAAGTATTCAAAA\n"}, "settings": {}}, {"id": "edits", "name": "TATA box with insertions and deletions", "program": "// Edit-distance demo: a TATA box that tolerates one substitution,\n// insertion or deletion. Every edit is typed by the DNA alphabet.\nalphabet DNA;\n\nmotif tata_exact = \"TATAWAWR\";\nmotif tata_mm    = \"TATAWAWR\" allow 1 mismatch;\nmotif tata_edit  = \"TATAWAWR\" allow 1 edits;\n\nsearch tata_exact in \"edits.fa\";\nsearch tata_mm    in \"edits.fa\";\nsearch tata_edit  in \"edits.fa\";\n", "files": {"edits.fa": ">edits_demo\nCCCCCCCCCCTATAAAAGCCCCCCCCCCTATAAAGCCCCCCCCCCTATACAAAGCCCCCCCCCCTATGAAAGCCCCCCCCCC\n"}, "settings": {}}, {"id": "promoter", "name": "Promoter built from named parts", "program": "// A eukaryotic core-promoter sketch: a TATA box upstream of a Kozak\n// sequence, separated by a variable spacer.\n\nalphabet DNA;\n\n// TATA box. W = A or T, R = A or G -- IUPAC codes are native symbols,\n// not something the user has to expand by hand.\nmotif tata = \"TATAWAWR\";\n\n// Kozak consensus: (gcc)gccRccATGG -- simplified to the core here.\nmotif kozak {\n    (\"A\" | \"G\") \"CC\" \"ATG\" \"G\"\n}\n\n// Polyadenylation signal, tolerant of one substitution.\nmotif polyA { \"AATAAA\" } allow 1 mismatch;\n\n// Composition: a promoter is a TATA box, a spacer of 20-40 arbitrary\n// bases, then a Kozak sequence.\nmotif promoter {\n    @tata \"N\"{20,40} @kozak\n}\n\n// A class with negation: any base that is not a purine.\nmotif pyrimidine_run {\n    [^AG]{3,}\n}\n\nsearch promoter in \"chr1.fa\";\nsearch polyA in \"chr1.fa\";\n", "files": {"chr1.fa": ">chr1 synthetic test sequence\nGGGGCCCCGGGGCCCCTATAAAAGGGGCCCCGGGGCCCCAAAAAAAAAAGCCATGGGGGGGGGCCCCC\nCCCGGGGAAAATAAAGGGGCCCCGGGGCCCC\n"}, "settings": {}}, {"id": "perpart", "name": "Separate error budget for each part", "program": "// Per-part budgets: a referenced motif keeps its own error budget\n// inside a composite. perpart.fa has three planted promoters:\n//   11  exact TATA box ... exact Kozak\n//   70  TATA box with one base deleted ... exact Kozak\n//  129  exact TATA box ... Kozak with one base deleted\nalphabet DNA;\n\nmotif tata  = \"TATAWAWR\" allow 1 edits;\nmotif kozak = \"RCCATGG\";\nmotif promoter { @tata \"N\"{20,40} @kozak }\n\nmotif tata0  = \"TATAWAWR\";\nmotif strict { @tata0 \"N\"{20,40} @kozak }\n\nsearch promoter in \"perpart.fa\";\nsearch strict   in \"perpart.fa\";\n", "files": {"perpart.fa": ">perpart\nCCCCCCCCCCTATAAAAGGGGGCCCCCGGGGGCCCCCGGGGGCCGCCATGGCCCCCCCCCCCCCCCCCCTATAAAGGGGGCCCCCGGGGGCCCCCGGGGGCCGCCATGGCCCCCCCCCCCCCCCCCCTATAAAAGGGGGCCCCCGGGGGCCCCCGGGGGCCGCATGGCCCCCCCCCC\n"}, "settings": {}}, {"id": "positions", "name": "Errors only at chosen positions", "program": "// Position-restricted errors: one mismatch, only at positions 1, 2 or 5\n// of AATAAA (the positions where most human PAS variants differ).\n// positions.fa: TATAAA (pos 1), AAGAAA (pos 3), AGTAAA (pos 2), AATATA (pos 5).\nalphabet DNA;\nmotif pas = \"AATAAA\" allow 1 mismatch at 1,2,5;\nsearch pas in \"positions.fa\";\n", "files": {"positions.fa": ">positions\nCCCTATAAACCCAAGAAACCCAGTAAACCCAATATACCC\n"}, "settings": {}}, {"id": "learn", "name": "Learn budget and positions from known sites", "program": "// The compiler chooses the budget AND the positions from known sites.\nalphabet DNA;\nmotif pas = \"AATAAA\" allow ? mismatch at ? require rate <= 40 per kb;\nsearch pas in \"positions.fa\";\n", "files": {"positions.fa": ">positions\nCCCTATAAACCCAAGAAACCCAGTAAACCCAATATACCC\n", "learn_sites.fa": ">s1\nCCATTAAACC\n>s2\nCCAGTAAACC\n>s3\nCCACTAAACC\n>s4\nCCAATAAACC\n>s5\nCCATTAAAGG\n", "learn_bg.fa": ">bg\\n"}, "settings": {"sites": "learn_sites.fa", "background": "learn_bg.fa", "markov": 1}}, {"id": "protein", "name": "Protein: glycosylation sites and zinc fingers", "program": "alphabet PROTEIN;\n\n// N-glycosylation sequon: N-X-S/T where X is any residue except proline.\n// Note that 'N' here is ASPARAGINE, a single specific residue -- not\n// \"any residue\" as it would be in DNA. Same character, different\n// meaning, resolved against the declared alphabet.\nmotif nglyc {\n    \"N\" [^P] (\"S\" | \"T\")\n}\n\n// 'X' is the protein wildcard, equivalent to any of the 20 residues.\nmotif zinc_finger {\n    \"C\" \"X\"{2,4} \"C\" \"X\"{12} \"H\" \"X\"{3,5} \"H\"\n}\n\nsearch nglyc in \"proteome.fa\";\nsearch zinc_finger in \"proteome.fa\";\n", "files": {"proteome.fa": ">sp|demo1 zinc-finger and glycosylation demo protein\nMKVLAAGNGSTRWPYKCPECGKSFSQSSNLQKHQRTHTGEKPNPTLLEAVNKTQ\n>sp|demo2 no zinc finger\nMSTNPSAGLLRRWEEDNPTAQKLLGG\n"}, "settings": {}}, {"id": "rna", "name": "RNA: Kozak sequence in transcripts", "program": "alphabet RNA;\n\n// Valid in RNA: U is uracil. The same literal would be rejected in DNA.\nmotif kozak_rna = \"GCCRCCAUGG\";\n\nsearch kozak_rna in \"transcripts.fa\";\n", "files": {"transcripts.fa": ">tx1 mRNA with a Kozak start\nGGAUCCAAGCCACCAUGGCUAGCAAGGAG\n>tx2 no strong Kozak\nGGAUCCAAGUUUAUGGCUAGCAAGGAG\n"}, "settings": {}}, {"id": "errors", "name": "Mistakes the compiler catches", "program": "// Three semantic mistakes the compiler must catch.\nalphabet DNA;\nmotif b     = \"GAAXTC\";               // X is not a DNA letter\nmotif short = \"TAG\" allow 3 edits;    // 3 deletions would match nothing\nsearch b     in \"demo.fa\";\nsearch short in \"demo.fa\";\nsearch d     in \"demo.fa\";            // d was never defined\n", "files": {"demo.fa": ">demo\nAAAAGAATTCAAAAAAGATTTCAAAAAAAGTATTCAAAA\n"}, "settings": {}}]